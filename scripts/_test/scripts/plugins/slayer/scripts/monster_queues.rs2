[queue,goblin_kill]
if (%active_slayer_task = ^goblin){
    @slayer_kill(%active_slayer_task, %task_amount, %current_count);
}

[queue,rat_kill]
if (%active_slayer_task = ^giant_rat){
    @slayer_kill(%active_slayer_task, %task_amount, %current_count);
}

[queue,hobgoblin_kill]
if (%active_slayer_task = ^hobgoblin){
    @slayer_kill(%active_slayer_task, %task_amount, %current_count);
}

[queue,skeleton_kill]
if (~wilderness_level(coord) > 0){
    obj_add(coord, ~wilderness_table_low, ^lootdrop_duration);
}
if (%active_slayer_task = ^skeleton){
    @slayer_kill(%active_slayer_task, %task_amount, %current_count);  
}

