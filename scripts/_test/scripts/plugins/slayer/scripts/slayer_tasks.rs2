[opnpc1,slayer_expert] @slayer_menu;
[opnpc3,slayer_expert] ~openshop_activenpc;
[opnpc4,slayer_expert] ~task_check;
[opheld1,slayer_gem] ~task_check;

[label,slayer_menu]
def_int $st = %slayer_tutorial;
~chatnpc("<p,shock>Hello <name>! I am the local Slayer expert!");
switch_int($st){
    case ^slayertutorial_notcomplete : {
        ~chatnpc("<p,happy>I could use an adventurer like you!");
        ~chatplayer("<p,confused>An adventurer like me...? How do you know me?");
        ~chatnpc("<p,neutral>That does not matter! I can give you a task to kill a certain number of monsters.");
        ~chatnpc("<p,neutral>If you complete the task you will be rewarded with slayer points.");
        ~chatnpc("<p,neutral>You can use these points to purchase various provisions from me.");
        ~chatnpc("<p,happy>First I need to show you the ropes!");
        ~chatnpc("<p,happy>Go kill a goblin to show your might!");
        %active_slayer_task = ^goblin;
        %task_amount = 1;
        %current_count = 0;
        %slayer_tutorial = ^slayertutorial_started;
    }
    case ^slayertutorial_started : {
        if (%active_slayer_task = ^goblin & %task_amount > 0){
            ~chatnpc("<p,neutral>Return to me when you have killed the goblin!");
            return;
        }
        ~chatnpc("<p,shock>You have killed a goblin!");
        ~chatnpc("<p,happy>You have earned 10 slayer points!");

        if (%prieststart = ^priest_complete){
            ~chatnpc("<p,neutral>Now I think you have the courage to explore beneath the graveyard");
            ~chatnpc("<p,neutral>Go use this spade and dig around inside the coffin.");
            inv_add(inv, spade, 1);
        } else {
            ~chatnpc("<p,neutral>Go speak with the priest as him about the graveyard.");
            ~chatnpc("<p,neutral>There are deeper mysteries to explore here..");
        }
        %slayer_tutorial = ^slayertutorial_complete;
    }
    case ^slayertutorial_goblins : { %slayer_tutorial = ^slayertutorial_started; }
    case ^slayertutorial_complete : {
        def_int $choice = ~p_choice4_header("New Task.", 1, "Check Task.", 2, "Buy Provisions.", 3, "Cancel Task.", 4, "*Slayer Menu*");
        switch_int($choice){
            case 1 : {
                if (%active_slayer_task = 0){
                    def_int $diff = ~p_choice3_header("Easy.", 1, "Medium.", 2, "Hard.", 3, "*Difficulty Selection*");
                    switch_int($diff){
                        case 1 : {
                            ~new_slayer_task(0);
                        }
                        case 2 : {
                            ~new_slayer_task(25);
                        }
                        case 3 : {
                            ~new_slayer_task(50);
                        }
                    }
                } else {
                    mes("You need to finish your current task of killing <tostring(~task_amount)> more <~task_name>");
                    return;
                }
            }
            case 2 : {
                ~task_check;
            }
            case 3 : {
                def_int $choice2 = ~p_choice3_header("Light(25 points)", 1, "Medium(100 points)", 2, "Heavy(500 points)", 3, "*Provisions Selection*");
                switch_int($choice2){
                    case 1 : {
                        if (%slayer_points < 25) {
                            mes("You do not have enough slayer points to buy this item.");
                            return;
                        }
                        %slayer_points = calc(%slayer_points - 25);
                        inv_add(inv,~buy_provisions(25));                
                    }
                    case 2 : {
                        if (%slayer_points < 100) {
                            mes("You do not have enough slayer points to buy this item.");
                            return;
                        }
                        %slayer_points = calc(%slayer_points - 100);
                        inv_add(inv,~buy_provisions(100));                
                    }
                    case 3 : {
                        if (%slayer_points < 500) {
                            mes("You do not have enough slayer points to buy this item.");
                            return;
                        }
                        %slayer_points = calc(%slayer_points - 500);
                        inv_add(inv,~buy_provisions(500));                
                    }
                }
            }
            case 4 : {
                if (%active_slayer_task = 0) {
                    mes("You do not have an active task.");
                    return;
                } else {
                    %active_slayer_task = 0;
                    %task_amount = 0;
                    %current_count = 0;
                    mes("Your task has been cleared.");
                    mes("Slayer Points: <tostring(%slayer_points)>");
                }
            }
        }

    }
    case default : {
        mes("You do not have an active task.");
        return;
    }
}

[label,slayer_kill](int $active_task, int $task_amount, int $current_count)
if (~task_complete($active_task, $task_amount, $current_count) = false){
    ~succesful_kill;
    if (inv_total(inv, player_ledger) > 0){
        mes("You have killed a <~task_name>, marking a notch in your logbook.");
    }
    return;
} else {
    return;
}


[proc,new_slayer_task](int $difficulty)
def_string $active_task;
def_int $random_task = random(6);
def_int $count = random(25);

switch_int($difficulty){
    case 0 : {
        $random_task = $random_task;
    }
    case 25 : {
        $random_task = calc($random_task + max(5, random(10)));
    }
    case 50 : {
        $random_task = calc($random_task + max(10, random(15)));
    }
}

switch_int($random_task){
    case 0 : {
        %active_slayer_task = ^giant_rat;
        $active_task = "Giant Rat";
    }
    case 1 : {
        %active_slayer_task = ^goblin;
        $active_task = "Goblin";
    }
    case 2 : {
        %active_slayer_task = ^skeleton;
        $active_task = "Skeleton";
    }
    case 3 : {
        %active_slayer_task = ^hobgoblin;
        $active_task = "Hobgoblin";
    }
    case 4 : {
        %active_slayer_task = ^wizard;
        $active_task = "Wizard";
    }
    case 5 : {
        %active_slayer_task = ^giant;
        $active_task = "Giant";
    }
    case 6 : {
        %active_slayer_task = ^mugger;
        $active_task = "Mugger";
    }
    case 7 : {
        %active_slayer_task = ^dark_wizard;
        $active_task = "Dark Wizard";
    }
    case 8 : {
        %active_slayer_task = ^moss_giant;
        $active_task = "Moss Giant";
    }
    case 9 : {
        %active_slayer_task = ^fire_giant;
        $active_task = "Fire Giant";
    }
    case 10 : {
        %active_slayer_task = ^green_dragon;
        $active_task = "Green Dragon";
    }
    case 11 : {
        %active_slayer_task = ^blue_dragon;
        $active_task = "Blue Dragon";
    }
    case 12 : {
        %active_slayer_task = ^red_dragon;
        $active_task = "Red Dragon";
    }
    case 13 : {
        %active_slayer_task = ^black_dragon;
        $active_task = "Black Dragon";
    }
    case 14 : {
        %active_slayer_task = ^ice_giant;
        $active_task = "Ice Giant";
    }
    case 15 : {
        %active_slayer_task = ^ice_warrior;
        $active_task = "Ice Warrior";
    }
    case 16 : {
        %active_slayer_task = ^hellhound;
        $active_task = "Hellhound";
    }
    case default : {
        %active_slayer_task = ^goblin;
        $active_task = "Goblin";
    }
}
def_int $task_amount = calc($count + $difficulty + random(12));
%task_amount = $task_amount;
%current_count = 0;
mes("Slay <tostring($task_amount)> <$active_task>'s.");
~mesbox("You now have a new slayer task!");

[proc,task_check]
mes("<tostring(~task_amount)> <~task_name> kills left.");
mes("Slayer Points: <tostring(%slayer_points)>");

[proc,task_reset]
%active_slayer_task = 0;
%task_amount = 0;
%current_count = 0;

[proc,task_amount]()(int)
def_int $remaining = calc(%task_amount - %current_count);
return($remaining);

[proc,task_name]()(string)
def_string $string;
def_int $active_task = calc(%active_slayer_task - 1);
switch_int($active_task){
    case 0 : { $string = "Giant Rat"; }
    case 1 : { $string = "Goblin"; }
    case 2 : { $string = "Skeleton"; }
    case 3 : { $string = "Hobgoblin"; }
    case 4 : { $string = "Wizard"; }
    case 5 : { $string = "Mugger"; }
    case 6 : { $string = "Giant"; }
    case 7 : { $string = "Dark Wizard"; }
    case 8 : { $string = "Moss Giant"; }
    case 9 : { $string = "Fire Giant"; }
    case 10 : { $string = "Green Dragon"; }
    case 11 : { $string = "Blue Dragon"; }
    case 12 : { $string = "Red Dragon"; }
    case 13 : { $string = "Black Dragon"; }
    case 14 : { $string = "Ice Giant"; }
    case 15 : { $string = "Ice Warrior"; }
    case 16 : { $string = "Hellhound"; }
    case default : { $string = "None"; }
}
return($string);

[proc,task_complete](int $active_task, int $task_amount, int $current_count)(boolean)
if ($active_task = 0){
    return(false);
}
if ($current_count >= $task_amount){
    return(true);
}
return(false);

[proc,succesful_kill]
%current_count = calc(%current_count + 1);
if (~task_amount <= 0) {
    if (%active_slayer_task > 12){
        %slayer_points = calc(%slayer_points + 10 + %active_slayer_task);
    } else {
        %slayer_points = calc(%slayer_points + 10);
    }
    mes("You have completed your task! Return to the Slayer expert for another.");
    ~task_reset;
    return;       
} else {
    mes("Remaining Kills: <tostring(~task_amount)> <~task_name>");
}


[proc,buy_provisions](int $cost)(namedobj, int)
switch_int($cost){
    case 25 : {
        return(light_case, 1);
    }
    case 100 : {
        return(medium_case, 1);
    }
    case 500 : {
        return(heavy_case, 1);
    }
}

[opheld1,slayer_hacks] @slayer_cheats;
[label,slayer_cheats]
def_int $int = ~p_choice2_header("Reset Task", 1, "Add 1000 Slayer Points", 2, "*Slayer Cheats*");
switch_int($int){
    case 1 : {
        %active_slayer_task = ^none;
        %task_amount = 0;
        %current_count = 0;
        mes("Task reset.");
    }
    case 2 : {
        %slayer_points = calc(%slayer_points + 1000);
        mes("1000 Slayer Points added.");
    }
}