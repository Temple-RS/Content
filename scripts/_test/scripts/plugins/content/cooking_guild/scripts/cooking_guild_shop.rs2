[opnpc3,head_chef] ~openshop_activenpc;
[opnpc1,head_chef]
~chatnpc("<p,happy>Hello, welcome to the Cooking Guild.|Only accomplished chefs and cooks are allowed in here.|Feel free to use any of our facilities.");
~chatnpc("<p,happy>Would you like to buy some cooking equipment?");
switch_int(~p_choice2("Yes please.", 1, "No thank you.", 2)) {
    case 1 : ~openshop_activenpc;
    case 2 : ~chatplayer("<p,neutral>No thank you."); 
}
