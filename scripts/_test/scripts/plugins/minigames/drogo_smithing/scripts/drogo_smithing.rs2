[label,drogo_smithing]
if (%doricquest ! ^doric_complete){
    ~chatnpc("<p,angry> You are not ready to help yet! Please help Doric with his quest first.");
    return;
} else if (%squire ! ^squire_complete){
    ~chatnpc("<p,angry> You are not ready to help yet! Please help the Squire with his quest first.");
    return;
}
switch_int(%drogo_status){
    case ^drogo_not_started : {
        def_int $choice = ~p_choice5_header("Blurite.", 1, "Elemental Cog.", 2, "Elemental Nails.", 3, "Cog Box.", 4, "Nail Box.", 5, "Task List.");
        switch_int($choice){
            case 1 : {
                if (inv_total(inv, blurite_bar) > 9){
                    ~chatnpc("<p,happy> Thank you for the blurite bars!");
                    inv_del(inv, blurite_bar, 10);
                    %drogo_status = ^drogo_not_started;
                    stat_advance(smithing, 2500);
                } else {
                    ~chatnpc("<p,happy> You don't have enough blurite bars!");
                    return;
                }
            }
            case 2 : {
                if (inv_total(inv, elemental_cog) > 99){
                    ~chatnpc("<p,happy> Thank you for the elemental cogs!");
                    inv_del(inv, elemental_cog, 100);
                    %drogo_status = ^drogo_not_started;
                    stat_advance(smithing, 1000);
                } else {
                    ~chatnpc("<p,happy> You don't have enough elemental cogs!");
                    return;
                }
            }
            case 3 : {
                if (inv_total(inv, elemental_nails) > 99){
                    ~chatnpc("<p,happy> Thank you for the elemental nails!");
                    inv_del(inv, elemental_nails, 100);
                    %drogo_status = ^drogo_not_started;
                    stat_advance(smithing, 1000);
                } else {
                    ~chatnpc("<p,happy> You don't have enough elemental nails!");
                    return;
                }                
            }
            case 4 : {
                if (inv_total(inv, elemental_cog_box) > 0){
                    ~chatnpc("<p,happy> Thank you for the elemental cog box!");
                    inv_del(inv, elemental_cog_box, 1);
                    %drogo_status = ^drogo_not_started;
                    stat_advance(smithing, 1100);
                } else {
                    ~chatnpc("<p,happy> You don't have enough elemental cog boxes!");
                    return;
                }
            }
            case 5 : {
                if (inv_total(inv, elemental_nail_box) > 0){
                    ~chatnpc("<p,happy> Thank you for the elemental nail box!");
                    inv_del(inv, elemental_nail_box, 1);
                    %drogo_status = ^drogo_not_started;
                    stat_advance(smithing, 1200);
                } else {
                    ~chatnpc("<p,happy> You don't have enough elemental nail boxes!");
                    return;
                }
            }
        }
    }
}
[opnpcu,drogo]{
    switch_obj(last_useitem){
        case elemental_cog_box : {
            inv_del(inv, elemental_cog_box, 1);
            stat_advance(smithing, 900);
            ~chatnpc("<p,happy> Thank you for the elemental cog box!");
        }
        case elemental_nail_box : {
            inv_del(inv, elemental_nail_box, 1);
            stat_advance(smithing, 1200);
            ~chatnpc("<p,happy> Thank you for the elemental nail box!");
        }
    }
}
[label,blurite_smithing]
def_int $tot = inv_total(inv, blurite_bar);
if (%squire ! ^squire_complete){
    ~mesbox("You do not know how to smith blurite bars yet.");
    return;
} else if (%doricquest ! ^doric_complete){
    ~mesbox("You do not know how to smith blurite bars yet.");
    return;
}
if ($tot < 5){
    ~mesbox("You do not have enough blurite bars.");
    return;
}
~smithing_action(blurite_bar, 5, faladian_sword, 1, 2375);


[proc,elemental_workshop](obj $item)
if(testbit(%elemental_workshop_bits, ^elemental_workshop_complete) = ^false){
    ~mesbox("You need to finish the Elemental Workshop quest first.");
    return;
}
def_int $total_ele = inv_total(inv, elemental_workshop_bar);
def_namedobj $product;
def_int $count;
def_int $exp;
def_int $choice = ~p_choice3("Cog.", 1, "Nails.", 2, "[Next]", 3);
switch_int($choice){
    case 1 : {
        if (stat_base(smithing) < 40){
            ~mesbox("You need level 40 smithing to make elemental cogs.");
            return;
        }
        $product = elemental_cog;
        $count = 1;
        $exp = 1000;
        if ($total_ele < $count){
            ~mesbox("You do not have enough elemental bars.");
            return;
        }
        ~workbench_action(elemental_workshop_bar, $count, $product, $count, $exp);
    }
    case 2 : {
        if (stat_base(smithing) < 50){
            ~mesbox("You need level 50 smithing to make elemental nails.");
            return;
        }
        $product = elemental_nails;
        $count = 5;
        $exp = 5500;
        if ($total_ele < $count){
            ~mesbox("You do not have enough elemental bars.");
            return;
        }
        ~workbench_action(elemental_workshop_bar, $count, $product, $count, $exp);
    }
    case 3 : {
        def_int $ch1 = ~p_choice4("Shield.", 1, "-", 2, "-", 3, "-", 4);
        switch_int($ch1){
            case 1 : {
                $product = elemental_shield;
                $count = 1;
                $exp = 180;
                if ($total_ele < $count){
                    ~mesbox("You do not have enough elemental bars.");
                    return;
                }
                ~workbench_action(elemental_workshop_bar, $count, $product, $count, $exp);
            }
            case 2 : return;
            case 3 : return;
            case 4 : return;
        }
    }
}

// info: Creates a cog box by using 100 elemental cogs and 5 planks on an elemental workbench.
[proc,create_cog_box]
if (stat_base(smithing) < 60){
    ~mesbox("You need level 60 smithing to make elemental cog boxes.");
    return;
}
if (~material_checker(hammer, 1, elemental_cog, 100, woodplank, 5, null, 0) = true){
    inv_del(inv, woodplank, 5);
    ~workbench_action(elemental_cog, 100, elemental_cog_box, 1, 3500);
} else {
    ~mesbox("You do not have enough materials.");
    return;
}

// info: Creates a nail box by using 100 elemental nails and 5 planks on an elemental workbench.
[proc,create_nail_box]
if (stat_base(smithing) < 70){
    ~mesbox("You need level 70 smithing to make elemental nail boxes.");
    return;
}
if (~material_checker(hammer, 1, elemental_nails, 100, woodplank, 5, null, 0) = true){
    inv_del(inv, woodplank, 5);
    ~workbench_action(elemental_nails, 100, elemental_nail_box, 1, 4500);
} else {
    ~mesbox("You do not have enough materials.");
    return;
}