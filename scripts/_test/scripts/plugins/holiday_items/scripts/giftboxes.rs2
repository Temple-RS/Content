[proc,rolltester]
def_int $r2 = random(10000);
def_int $var = calc($r2 - (map_clock));
mes("Var: <tostring($var)>");
switch_int($var){
    case 255 : 
        mes("Successful Proc! 255");
    case 325 :
        mes("Succesful Proc!! 325");
}