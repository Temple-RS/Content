[oplocu,rc_air_altar] 
    switch_obj(last_useitem){
        case air_talisman : 
            ~tiara_crafting(tiara_air, air_talisman);
        case tiara : {
            if (inv_total(inv, air_talisman) < 1){
                mes("You need an Air talisman to do this.");
                return;
            }
            ~tiara_crafting(tiara_air, air_talisman);
        }
        case default : ~displaymessage(^dm_default);
    }
