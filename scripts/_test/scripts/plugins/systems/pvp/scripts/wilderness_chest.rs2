[oploc1,wilderness_chestclosed]
mes("The chest is locked.");
sound_synth(locked, 0, 0);

[oplocu,wilderness_chestclosed]
def_coord $loc_coord = loc_coord;
def_locshape $loc_shape = loc_shape;
def_int $loc_angle = loc_angle;

if (last_useitem ! wc_key) {
    ~displaymessage(^dm_default);
    return;
}
def_int $random_respawn = max(random(30000), max(100000, random(140000)));
mes("Chest will respawn in <tostring($random_respawn)>.");
anim(human_openchest, 0);
sound_synth(chest_open, 0, 0);
mes("You unlock the chest with your key.");
p_delay(0);
loc_change(wilderness_chestopen, $random_respawn);
inv_del(inv, wc_key, 1);
p_delay(0);


[opheld2,wilderness_cape] @defence_limit(1, last_slot);
[opheld2,wilderness_ring] @defence_limit(1, last_slot);
[opheld3,wilderness_ring] ~wring_toggle;
[opheld4,wilderness_ring] ~combat_level_menu;
[opheld2,wilderness_necklace] @defence_limit(1, last_slot);

[label,defence_limit](int $level, int $slot)
if (stat_base(defence) < $level) {
    mes("Your defence is too low to use this item.");
    return;
}
~equip($slot);

// -------------------------------------------------------
// TOGGLE — activates ALL configured skill levels at once,
// or restores them all when toggled off.
// -------------------------------------------------------

[proc,wring_toggle]
if (~wilderness_level(coord) > 0) {
    mes("You can't use this in the wilderness.");
    return;
}
switch_int(%wilderness_defence_toggle) {
    case 0 : {
        // TOGGLE ON: save original XPs, apply target levels, skull
        ~wring_save_all_xp;
        ~wring_apply_all_targets;
        %wilderness_defence_toggle = 1;
        ~pk_skull(^max_32bit_int);
        mes("Skill levels applied. You have been skulled.");
    }
    case 1 : {
        // TOGGLE OFF: restore all original XPs, clear skull
        ~wring_restore_all;
        %wilderness_defence_toggle = 0;
        ~clear_pk_skull;
        mes("Your levels have been restored.");
    }
}

// -------------------------------------------------------
// Save current XP for all 6 stats to their _exp varps.
// -------------------------------------------------------

[proc,wring_save_all_xp]
def_int $current_xp = 0;

$current_xp = stat_xp(attack);
if ($current_xp > 0) { %wilderness_attack_exp = $current_xp; }

$current_xp = stat_xp(strength);
if ($current_xp > 0) { %wilderness_strength_exp = $current_xp; }

$current_xp = stat_xp(defence);
if ($current_xp > 0) { %wilderness_defence_exp = $current_xp; }

$current_xp = stat_xp(ranged);
if ($current_xp > 0) { %wilderness_ranged_exp = $current_xp; }

$current_xp = stat_xp(magic);
if ($current_xp > 0) { %wilderness_magic_exp = $current_xp; }

$current_xp = stat_xp(prayer);
if ($current_xp > 0) { %wilderness_prayer_exp = $current_xp; }


// -------------------------------------------------------
// Apply configured target levels for all 6 stats.
// -------------------------------------------------------

[proc,wring_apply_all_targets]
def_int $xp = 0;

if (%wilderness_attack_target > 1) { $xp = ~xp_for_level(%wilderness_attack_target); } else { $xp = 0; }
stat_setxp(attack, $xp);

if (%wilderness_strength_target > 1) { $xp = ~xp_for_level(%wilderness_strength_target); } else { $xp = 0; }
stat_setxp(strength, $xp);

if (%wilderness_defence_target > 1) { $xp = ~xp_for_level(%wilderness_defence_target); } else { $xp = 0; }
stat_setxp(defence, $xp);

if (%wilderness_ranged_target > 1) { $xp = ~xp_for_level(%wilderness_ranged_target); } else { $xp = 0; }
stat_setxp(ranged, $xp);

if (%wilderness_magic_target > 1) { $xp = ~xp_for_level(%wilderness_magic_target); } else { $xp = 0; }
stat_setxp(magic, $xp);

if (%wilderness_prayer_target > 1) { $xp = ~xp_for_level(%wilderness_prayer_target); } else { $xp = 0; }
stat_setxp(prayer, $xp);


// -------------------------------------------------------
// Restore all 6 stats from their saved _exp varps.
// -------------------------------------------------------

[proc,wring_restore_all]
if (%wilderness_attack_exp > 0) {
    stat_setxp(attack, %wilderness_attack_exp);
    %wilderness_attack_exp = 0;
}
if (%wilderness_strength_exp > 0) {
    stat_setxp(strength, %wilderness_strength_exp);
    %wilderness_strength_exp = 0;
}
if (%wilderness_defence_exp > 0) {
    stat_setxp(defence, %wilderness_defence_exp);
    %wilderness_defence_exp = 0;
}
if (%wilderness_ranged_exp > 0) {
    stat_setxp(ranged, %wilderness_ranged_exp);
    %wilderness_ranged_exp = 0;
}
if (%wilderness_magic_exp > 0) {
    stat_setxp(magic, %wilderness_magic_exp);
    %wilderness_magic_exp = 0;
}
if (%wilderness_prayer_exp > 0) {
    stat_setxp(prayer, %wilderness_prayer_exp);
    %wilderness_prayer_exp = 0;
}

// -------------------------------------------------------
// SET LEVELS MENU (iop4) 
// -------------------------------------------------------

[proc,combat_level_menu]
if (~wilderness_level(coord) > 0) {
    mes("You can't use this in the wilderness.");
    return;
}
def_int $stat_choice = ~p_choice5_header(
    "Attack", 1,
    "Strength", 2,
    "Defence", 3,
    "Ranged", 4,
    "More...", 5,
    "Set Target Level:");

def_int $max_level = 1;
def_int $current_target = 1;
def_int $target = 1;

if ($stat_choice = 1) {
    if (%wilderness_attack_exp > 0) { $max_level = ~level_from_xp(%wilderness_attack_exp); } else { $max_level = stat_base(attack); }
    $current_target = %wilderness_attack_target;
    if ($current_target = 0) $current_target = 1;
    ~mesbox("Attack — current target: <tostring($current_target)>. Enter new target (1 - <tostring($max_level)>):");
    p_countdialog;
    $target = last_int;
    if ($target < 1) { mes("Level must be at least 1."); return; }
    if ($target > $max_level) { mes("You can't set your target above <tostring($max_level)>."); return; }
    %wilderness_attack_target = $target;
    mes("Attack target set to level <tostring($target)>.");

} else if ($stat_choice = 2) {
    if (%wilderness_strength_exp > 0) { $max_level = ~level_from_xp(%wilderness_strength_exp); } else { $max_level = stat_base(strength); }
    $current_target = %wilderness_strength_target;
    if ($current_target = 0) $current_target = 1;
    ~mesbox("Strength — current target: <tostring($current_target)>. Enter new target (1 - <tostring($max_level)>):");
    p_countdialog;
    $target = last_int;
    if ($target < 1) { mes("Level must be at least 1."); return; }
    if ($target > $max_level) { mes("You can't set your target above <tostring($max_level)>."); return; }
    %wilderness_strength_target = $target;
    mes("Strength target set to level <tostring($target)>.");

} else if ($stat_choice = 3) {
    if (%wilderness_defence_exp > 0) { $max_level = ~level_from_xp(%wilderness_defence_exp); } else { $max_level = stat_base(defence); }
    $current_target = %wilderness_defence_target;
    if ($current_target = 0) $current_target = 1;
    ~mesbox("Defence — current target: <tostring($current_target)>. Enter new target (1 - <tostring($max_level)>):");
    p_countdialog;
    $target = last_int;
    if ($target < 1) { mes("Level must be at least 1."); return; }
    if ($target > $max_level) { mes("You can't set your target above <tostring($max_level)>."); return; }
    %wilderness_defence_target = $target;
    mes("Defence target set to level <tostring($target)>.");

} else if ($stat_choice = 4) {
    if (%wilderness_ranged_exp > 0) { $max_level = ~level_from_xp(%wilderness_ranged_exp); } else { $max_level = stat_base(ranged); }
    $current_target = %wilderness_ranged_target;
    if ($current_target = 0) $current_target = 1;
    ~mesbox("Ranged — current target: <tostring($current_target)>. Enter new target (1 - <tostring($max_level)>):");
    p_countdialog;
    $target = last_int;
    if ($target < 1) { mes("Level must be at least 1."); return; }
    if ($target > $max_level) { mes("You can't set your target above <tostring($max_level)>."); return; }
    %wilderness_ranged_target = $target;
    mes("Ranged target set to level <tostring($target)>.");

} else if ($stat_choice = 5) {
    def_int $stat_choice2 = ~p_choice2_header(
        "Magic", 1,
        "Prayer", 2,
        "Set Target Level:");

    if ($stat_choice2 = 1) {
        if (%wilderness_magic_exp > 0) { $max_level = ~level_from_xp(%wilderness_magic_exp); } else { $max_level = stat_base(magic); }
        $current_target = %wilderness_magic_target;
        if ($current_target = 0) $current_target = 1;
        ~mesbox("Magic — current target: <tostring($current_target)>. Enter new target (1 - <tostring($max_level)>):");
        p_countdialog;
        $target = last_int;
        if ($target < 1) { mes("Level must be at least 1."); return; }
        if ($target > $max_level) { mes("You can't set your target above <tostring($max_level)>."); return; }
        %wilderness_magic_target = $target;
        mes("Magic target set to level <tostring($target)>.");

    } else {
        if (%wilderness_prayer_exp > 0) { $max_level = ~level_from_xp(%wilderness_prayer_exp); } else { $max_level = stat_base(prayer); }
        $current_target = %wilderness_prayer_target;
        if ($current_target = 0) $current_target = 1;
        ~mesbox("Prayer — current target: <tostring($current_target)>. Enter new target (1 - <tostring($max_level)>):");
        p_countdialog;
        $target = last_int;
        if ($target < 1) { mes("Level must be at least 1."); return; }
        if ($target > $max_level) { mes("You can't set your target above <tostring($max_level)>."); return; }
        %wilderness_prayer_target = $target;
        mes("Prayer target set to level <tostring($target)>.");
    }
}


// -------------------------------------------------------
// XP-for-level lookup  (exact RS XP table, levels 1-99)
// -------------------------------------------------------

[proc,xp_for_level](int $level)(int)
if ($level < 1) $level = 1;
if ($level > 99) $level = 99;
switch_int($level) {
    case 1  : return(0);    case 2  : return(830);   case 3  : return(1740);  case 4  : return(2760);
    case 5  : return(3880);  case 6  : return(5120);  case 7  : return(6500);  case 8  : return(8010);
    case 9  : return(9690);  case 10 : return(11540); case 11 : return(13580); case 12 : return(15840);
    case 13 : return(18330); case 14 : return(21070); case 15 : return(24110); case 16 : return(27460);
    case 17 : return(31150); case 18 : return(35230); case 19 : return(39730); case 20 : return(44700);
    case 21 : return(50180); case 22 : return(56240); case 23 : return(62910); case 24 : return(70280);
    case 25 : return(78420); case 26 : return(87400); case 27 : return(97300); case 28 : return(108240);
    case 29 : return(120310);case 30 : return(133630);case 31 : return(148330);case 32 : return(164560);
    case 33 : return(182470);case 34 : return(202240);case 35 : return(224060);case 36 : return(248150);
    case 37 : return(274730);case 38 : return(304080);case 39 : return(336480);case 40 : return(372240);
    case 41 : return(411710);case 42 : return(455290);case 43 : return(503390);case 44 : return(556490);
    case 45 : return(615120);case 46 : return(679830);case 47 : return(751270);case 48 : return(830140);
    case 49 : return(917210);case 50 : return(1013330);case 51 : return(1119450);case 52 : return(1236600);
    case 53 : return(1365940);case 54 : return(1508720);case 55 : return(1666360);case 56 : return(1840400);
    case 57 : return(2032540);case 58 : return(2244660);case 59 : return(2478860);case 60 : return(2737420);
    case 61 : return(3022880);case 62 : return(3338040);case 63 : return(3685990);case 64 : return(4070150);
    case 65 : return(4494280);case 66 : return(4962540);case 67 : return(5479530);case 68 : return(6050320);
    case 69 : return(6680510);case 70 : return(7376270);case 71 : return(8144450);case 72 : return(8992570);
    case 73 : return(9928950);case 74 : return(10962780);case 75 : return(12104210);case 76 : return(13364430);
    case 77 : return(14755810);case 78 : return(16292000);case 79 : return(17988080);case 80 : return(19860680);
    case 81 : return(21928180);case 82 : return(24210870);case 83 : return(26731140);case 84 : return(29513730);
    case 85 : return(32585940);case 86 : return(35977920);case 87 : return(39722940);case 88 : return(43857760);
    case 89 : return(48422950);case 90 : return(53463320);case 91 : return(59028310);case 92 : return(65172530);
    case 93 : return(71956290);case 94 : return(79446140);case 95 : return(87715580);case 96 : return(96845770);
    case 97 : return(106926290);case 98 : return(118056060);case 99 : return(130344310);
    case default : return(0);
}

