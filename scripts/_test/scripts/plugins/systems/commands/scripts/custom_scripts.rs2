// info: Pays the toll gate.
[proc,easy_pay](loc $loc)
switch_loc($loc){
    case border_gate_toll_left : {
        if (inv_total(inv, coins) < 10) {
            ~chatplayer("<p,quiz>Oh dear, I don't actually seem to have enough money.");
            return;
        }      
        mes("You pay the guard.");
        inv_del(inv, coins, 10);
    }
    case border_gate_toll_right : {
        if (inv_total(inv, coins) < 10) {
            ~chatplayer("<p,quiz>Oh dear, I don't actually seem to have enough money.");
            return;
        }        
        mes("You pay the guard.");
        inv_del(inv, coins, 10);
    }
}

// info: Returns the crafting speed based on the player's skill level. [ 90: 1t | 75: 2t | 50: 3t | 25: 4t | 1: 5t ]
[proc,stat_speed](stat $skill)(int)
def_int $level = stat_base($skill);
def_int $speed = 5;
if ($level > 25) { $speed = 4;}
if ($level > 50) { $speed = 3;}
if ($level > 80) { $speed = 2;}
if ($level > 95) { $speed = 1;}
return($speed);

// info: String Maker
[proc,string_maker](obj $obj, string $obj_name, int $amount, string $loc_name, string $action_name)
switch_obj($obj){
    case elemental_workshop_lava_bowl_full : {
        mes("You <$action_name> to the <$loc_name>.");
        return;
    }
}



[label,end_label]
return;

