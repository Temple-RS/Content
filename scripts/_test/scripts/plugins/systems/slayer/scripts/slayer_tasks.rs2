def_int $task_amount = calc($difficulty + random(12) + 15);
%task_amount = $task_amount;
%current_count = 0;
if (%task_amount < 10){
    %task_amount = 10;
}
$task_amount = %task_amount;

mes("Slay <tostring($task_amount)> <~task_name>.");
~chatnpc("<p,neutral>You now have a new task of killing <tostring($task_amount)> <~task_name>.");

[proc,task_check]
mes("<tostring(~task_amount)> <~task_name> kills left.");
mes("Slayer Points: <tostring(%slayer_points)>");

[proc,task_reset]
%active_slayer_task = 0;
%task_amount = 0;
%current_count = 0;

[proc,task_amount]()(int)
def_int $remaining = calc(%task_amount - %current_count);
return($remaining);

[proc,task_name]()(string)
def_string $string;
def_int $amount = ~task_amount;
switch_int(%active_slayer_task){
    case ^chicken : { $string = "Chickens"; }
    case ^cow : { $string = "Cows"; }
    case ^goblin : { $string = "Goblins"; }
    case ^imp : { $string = "Imps"; }
    case ^man : { $string = "Men"; }
    case ^giant_rat : { $string = "Giant Rats"; }
    case ^highwayman : { $string = "Highwaymen"; }
    case ^mugger : { $string = "Muggers"; }
    case ^farmer : { $string = "Farmers"; }
    case ^dark_wizard : { $string = "Dark Wizards"; }
    case ^barbarian : { $string = "Barbarians"; }
    case ^wizard : { $string = "Wizards"; }
    case ^druid : { $string = "Druids"; }
    case ^dwarf : { $string = "Dwarves"; }
    case ^thug : { $string = "Thugs"; }
    case ^chaos_druid : { $string = "Chaos Druids"; }
    case ^zombie : { $string = "Zombies"; }
    case ^rogue : { $string = "Rogues"; }
    case ^unicorn : { $string = "Unicorns"; }
    case ^bear : { $string = "Bears"; }
    case ^guard : { $string = "Guards"; }
    case ^skeleton : { $string = "Skeletons"; }
    case ^pirate : { $string = "Pirates"; }
    case ^giant : { $string = "Giants"; }
    case ^hobgoblin : { $string = "Hobgoblins"; }
    case ^moss_giant : { $string = "Moss Giants"; }
    case ^chaos_dwarf : { $string = "Chaos Dwarves"; }
    case ^earth_warrior : { $string = "Earth Warriors"; }
    case ^ice_giant : { $string = "Ice Giants"; }
    case ^jogre : { $string = "Jogres"; }
    case ^bandit : { $string = "Bandits"; }
    case ^ice_warrior : { $string = "Ice Warriors"; }
    case ^tribesman : { $string = "Tribesmen"; }
    case ^chaos_druid_warrior : { $string = "Chaos Druid Warriors"; }
    case ^green_dragon : { $string = "Green Dragons"; }
    case ^lesser_demon : { $string = "Lesser Demons"; }
    case ^fire_giant : { $string = "Fire Giants"; }
    case ^greater_demon : { $string = "Greater Demons"; }
    case ^blue_dragon : { $string = "Blue Dragons"; }
    case ^hellhound : { $string = "Hellhounds"; }
    case ^red_dragon : { $string = "Red Dragons"; }
    case ^black_demon : { $string = "Black Demons"; }
    case ^black_dragon : { $string = "Black Dragons"; }
    case default : { $string = "None"; }
}

if ($amount = 1) {
    switch_int(%active_slayer_task){
        case ^man : { $string = "Man"; }
        case ^dwarf : { $string = "Dwarf"; }
        case ^chaos_dwarf : { $string = "Chaos Dwarf"; }
        case ^tribesman : { $string = "Tribesman"; }
        case ^highwayman : { $string = "Highwayman"; }
    }
}

return($string);

[proc,task_complete](int $active_task, int $task_amount, int $current_count)(boolean)
if ($active_task = 0){
    return(false);
}
if ($current_count >= $task_amount){
    return(true);
}
return(false);

[proc,succesful_kill]
%current_count = calc(%current_count + 1);
if (~task_amount <= 0) {
    if (%task_difficulty = 2){
        %slayer_points = calc(%slayer_points + 50);
    } else if (%task_difficulty = 1) {
        %slayer_points = calc(%slayer_points + 25);
    } else {
        %slayer_points = calc(%slayer_points + 10);
    }
    mes("You have completed your task! Return to the Slayer expert for another.");
    ~task_reset;
    return;       
} else {
    mes("Remaining Kills: <tostring(~task_amount)> <~task_name>");
}


[proc,buy_provisions](int $cost)(namedobj, int)
switch_int($cost){
    case 25 : {
        return(light_case, 1);
    }
    case 100 : {
        return(medium_case, 1);
    }
    case 500 : {
        return(heavy_case, 1);
    }
}

[opheld1,slayer_hacks] @slayer_cheats;
[label,slayer_cheats]
def_int $int = ~p_choice2_header("Reset Task", 1, "Add 1000 Slayer Points", 2, "*Slayer Cheats*");
switch_int($int){
    case 1 : {
        %active_slayer_task = ^none;
        %task_amount = 0;
        %current_count = 0;
        mes("Task reset.");
    }
    case 2 : {
        %slayer_points = calc(%slayer_points + 1000);
        mes("1000 Slayer Points added.");
    }
}