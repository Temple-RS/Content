[queue,goblin_kill]
if (%active_slayer_task = ^goblin){
    @slayer_kill(%active_slayer_task, %task_amount, %current_count);
}

[queue,rat_kill]
if (%active_slayer_task = ^giant_rat){
    @slayer_kill(%active_slayer_task, %task_amount, %current_count);
}

