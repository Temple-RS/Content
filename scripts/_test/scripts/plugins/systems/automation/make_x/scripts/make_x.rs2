[proc,make_options](obj $obj)(int)
def_int $choice = ~p_choice4("1.", 1, "5.", 2, "10.", 3, "X.", 4);
switch_int($choice){
    case 1 : return(1);
    case 2 : return(5);
    case 3 : return(10);
    case 4 : {
        p_countdialog;
        def_int $last_int = last_int;
        if ($last_int > inv_total($obj) | $last_int > 28){
           def_int $difference = calc($last_int - inv_total($obj)); 
        } 
        return($last_int);
    } 
}

[proc,make_x](obj $obj, int $count)(int)
def_int $inv_total = inv_total(inv, $obj);
if ($inv_total < 1){
    return(0);
}
