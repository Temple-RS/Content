[opheld3,player_ledger]
%book_page = 0;
%open_book = player_ledger;
@open_player_ledger;

[label,open_player_ledger]
@book_flip_page(0, 0, 1, player_ledger_book);

[proc,player_ledger_book]
def_int $player_count = playercount;
def_string $player_name = displayname;
def_string $dragonslayer = "Incomplete";
def_string $legendsquest = "Incomplete";
def_string $heroesquest = "Incomplete";
def_string $vipstatus = "@whi@0@bla@";


def_int $donation_exp = %donation_exp;
def_int $fountain_donations = %fountain_donations;
def_int $voucher_totals = %voucher_totals;


def_int $rc_ta = %rc_taskamount;
def_int $rc_tp = %rc_taskprogress;
def_int $rc_rep = %rc_rep;


//Slayer
def_int $slayer_taskamount = %task_amount;
def_int $slayer_currentcount = %current_count;
def_int $slayer_points = %slayer_points;

switch_int(%vip_level){
    case 1 : {
        $vipstatus = "@gre@Guest@bla@";
    }
    case 2 : {
        $vipstatus = "@yel@1@bla@";
    }
    case 3 : {
        $vipstatus = "@ora@2@bla@";
    }
    case 4 : {
        $vipstatus = "@red@3@bla@";
    }
}

if (%dragonquest = ^dragon_complete) {
    $dragonslayer = "@gre@YES@bla@";
} else {
    $dragonslayer = "@red@NO@bla@";
}
if (%legendsquest = ^legends_complete) {
    $legendsquest = "@gre@YES@bla@";
} else {
    $legendsquest = "@red@NO@bla@";
}

if (%heroquest = ^hero_complete) {
    $heroesquest = "@gre@YES@bla@";
} else {
    $heroesquest = "@red@NO@bla@";
}

switch_int (%book_page) {

    case 0 : ~book("The Ledger of Action", 
    "@red@Welcome, <$player_name>||@bla@This ledger records your skills, PvP stats, kills, and your rare treasures.||Unlock the next steps in your path to |glory and greatness.|||@blu@Account Info |@bla@Players Online: [@whi@<tostring($player_count)>@bla@] |@yel@VIP@bla@: @whi@<$vipstatus>|@bla@Vouchers: $@gre@<tostring($voucher_totals)>@bla@|@bla@Fountain[@gre@EXP@bla@]: |@yel@<tostring($fountain_donations)>gp @bla@(@gre@<tostring($donation_exp)>@bla@)|||");
    case 1 : ~book("All Tasks",
    "@bla@Runecrafting: | [@whi@<tostring($rc_tp)>/<tostring($rc_ta)>@bla@] Remain | @bla@Reputation: | [@whi@<tostring($rc_rep)>/30,000@bla@]||@bla@Slayer Task: | [@whi@<tostring(%current_count)>@bla@/@whi@<tostring(~task_amount)>@bla@] Remain| [@whi@<tostring(~task_amount)>@bla@x @whi@<~task_name>@bla@] | @bla@Points: [@whi@<tostring(%slayer_points)>@bla@] |||@bla@Dragon Slayer I: @whi@<$dragonslayer> |@bla@Legends Quest: @whi@<$legendsquest> |@bla@Heroes Quest: @whi@<$heroesquest>|@blu@Quest Points@bla@: @blu@<tostring(~count_questpoints)>  |||");
    case 2 : ~book("All Stats",
    "@bla@Attack: @whi@<tostring(stat_base(attack))>/99@bla@ |Strength: @whi@<tostring(stat_base(strength))>/99@bla@ |Defence: @whi@<tostring(stat_base(defence))>/99@bla@ |Ranged: @whi@<tostring(stat_base(ranged))>/99@bla@ |Prayer: @whi@<tostring(stat_base(prayer))>/99@bla@ |Magic: @whi@<tostring(stat_base(magic))>/99@bla@ |Hitpoints: @whi@<tostring(stat_base(hitpoints))>/99@bla@ |Runecraft: @whi@<tostring(stat_base(runecraft))>/99@bla@ |Agility: @whi@<tostring(stat_base(agility))>/99@bla@ |Herblore: @whi@<tostring(stat_base(herblore))>/99@bla@ |Thieving: @whi@<tostring(stat_base(thieving))>/99@bla@ |Crafting: @whi@<tostring(stat_base(crafting))>/99@bla@ |Mining: @whi@<tostring(stat_base(mining))>/99@bla@ |Smithing: @whi@<tostring(stat_base(smithing))>/99@bla@ |Fishing: @whi@<tostring(stat_base(fishing))>/99@bla@ |Cooking: @whi@<tostring(stat_base(cooking))>/99@bla@ |Firemaking: @whi@<tostring(stat_base(firemaking))>/99@bla@ |Woodcutting: @whi@<tostring(stat_base(woodcutting))>/99@bla@|||");
}