[label,wilderness_drop](int $tier)
if (random(128) > 126){
    def_coord $event_coord = map_findsquare(coord, 1, 1, ^map_findsquare_lineofwalk);
    spotanim_map(smokepuff, $event_coord, 124, 0);
    sound_synth(smokepuff, 0, 0);
    def_npc $npc;
    def_seq $seq;
    def_string $string;
    switch_int(random(1)){
        case 0 : {
            $npc = imp_wild;
            switch_int(random(2)){
                case 0 : {
                    $string = "Catch me if you can!";
                }
                case 1 : {
                    $string = "I'm off!";
                }
                case 2 : {
                    $string = "Hmph.";
                }
            }
            $seq = null;
        }
        //case 1 : {
        //    $npc = yeti_wild;
        //    switch_int(random(2)){
        //        case 0 : {
        //            $string = "Glah Daah!";
        //        }
        //        case 1 : {
        //            $string = "Derr Roogar!";
        //        }
        //        case 2 : {
        //            $string = "Ad Rog Doofah!";
        //        }
        //    }
        //    $seq = null;        }
        case 1 : {
            $npc = mysterious_old_man;
            switch_int(random(2)){
                case 0 : {
                    $string = "Take care of it!";
                }
                case 1 : {
                    $string = "This is my precious gift!";
                }
                case 2 : {
                    $string = "I'm off!";
                }
            }
            $seq = emote_bow;
        }
    }
    npc_add($event_coord, $npc, 1000);
    npc_setmode(playerfollow);
    npc_delay(0);
    def_int $openslot = ~open_slot(28, inv);
    switch_int($tier) {
        case 0 : {
            inv_add(inv, ~wilderness_table_low);
        }
        case 1 : {
            inv_add(inv, ~wilderness_table);
        }
    }
    def_obj $obj = inv_getobj(inv, calc($openslot + 1));
    def_int $count = inv_total(inv, $obj);
    if ($count > 1){
        mes("You received some items!");
    } else {
        mes("You received an item!");
    }
    npc_say("<$string>");
    if ($seq ! null){
        npc_anim($seq, 0);
    }
    spotanim_map(smokepuff, npc_coord, 124, 0);
    sound_synth(smokepuff, 0, 0);
    npc_del;
}