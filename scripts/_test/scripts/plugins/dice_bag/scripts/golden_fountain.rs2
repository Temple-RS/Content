[oploc1,goldfountain] 
//~openshop_temple(golden_fountain, 0, ^max_32bit_int, 0, "Wishing Fountain");
~mesbox("You have donated <tostring(%fountain_donations)>gp |The fountain have <tostring(%donation_exp)> donation exp.");



[oplocu,goldfountain]
switch_obj(last_useitem){
    case coins : {
        facesquare(loc_coord);
        p_arrivedelay;
        ~donate_to_fountain(coins);
    }
    case default : { ~displaymessage(^dm_default); }
}
// info: Donate 5,000 gp for 5,000 donation exp, if the amoutn donated is more than 5,000 gp, the difference is returned
[proc,donate_to_fountain](namedobj $coins)
~mesbox("How much would you like to donate?");
p_countdialog;

def_namedobj $coins2;
def_int $amount = last_int;

if ($amount <= 0) {
    return;
}

switch_namedobj($coins){
    case coins : { $coins2 = coins; }
}

// Clamp amount to what the player actually has in their inventory to prevent item deletion/dupe exploits
def_int $held = inv_total(inv, $coins2);
if ($amount > $held) {
    $amount = $held;
}

if (%donation_exp >= 5000) {
    mes("You already have donated enough!");
    return;
}

// Clamp the amount to the maximum limit of 5000 exp
def_int $total = calc($amount + %donation_exp);
if ($total > 5000){
    def_int $difference = calc($total - 5000);
    $amount = calc($amount - $difference);
}

if ($amount > 0) {
    inv_add(golden_fountain, $coins2, $amount);
    inv_del(inv, $coins2, $amount);
    
    %donation_exp = calc(%donation_exp + $amount);
    %fountain_donations = calc(%fountain_donations + $amount);

    anim(human_pickupfloor, 0);
}