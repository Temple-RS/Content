[oploc1,goldfountain] 
~mesbox("You have donated <tostring(%fountain_donations)> gold total. |The fountain has <tostring(%donation_exp)> donation experience remaining in your pool.");



[oplocu,goldfountain]
switch_obj(last_useitem){
    case coins : {
        facesquare(loc_coord);
        p_arrivedelay;
        ~donate_to_fountain(coins);
    }
    case default : { ~displaymessage(^dm_default); }
}

[proc,donate_to_fountain](namedobj $coins)
if (%donation_exp >= 5000) {
    mes("Your donation experience pool is already at the 5,000 exp cap.");
    return;
}

~mesbox("How much would you like to donate? |(10 gold = 1 exp)");
p_countdialog;

def_int $amount = last_int;

if ($amount <= 0) {
    return;
}

// Clamp to what the player actually has
def_int $held = inv_total(inv, $coins);
if ($amount > $held) {
    $amount = $held;
}

// Calculate how much more exp we can accept
def_int $remaining_exp = calc(5000 - %donation_exp);
// Calculate how much gold that corresponds to (10gp : 1exp)
def_int $max_gold_accepted = calc($remaining_exp * 10);

// Clamp amount to the fountain's capacity
if ($amount > $max_gold_accepted) {
    $amount = $max_gold_accepted;
}

// Ensure we only take gold in multiples of 10 to maintain the ratio
def_int $exp_gain = calc($amount / 10);
$amount = calc($exp_gain * 10);

if ($amount <= 0) {
    mes("The fountain only accepts donations in chunks of at least 10 gold.");
    return;
}

inv_del(inv, $coins, $amount);
// inv_add(golden_fountain, $coins, $amount); // Keep original behavior if golden_fountain is a valid container

%fountain_donations = calc(%fountain_donations + $amount);
%donation_exp = calc(%donation_exp + $exp_gain);

anim(human_pickupfloor, 0);
mes("You donate <tostring($amount)> gold and receive <tostring($exp_gain)> donation experience.");