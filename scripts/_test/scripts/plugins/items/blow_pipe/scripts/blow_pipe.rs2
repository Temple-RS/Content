[opheld2,blow_dart] ~equip(last_slot);
[opheld2,blow_pipe] ~equip(last_slot);
[opheldu,kalphite_stinger] 
switch_obj(last_useitem){
    case feather : {
        if (~tool_check(knife) = true){
            ~cutting_animation;
            if (inv_total(inv, feather) < 15) {
                mes("You need at least 15 feathers to do this.");
                return;
            }
            inv_del(inv, kalphite_stinger, 1);
            inv_del(inv, feather, 15);
            inv_add(inv, blow_dart, 15);
            stat_advance(fletching, 750);
            mes("You shave down the stinger and attach the feather make some darts.");
        }
    }
    case knife : {
        if (~tool_check(feather) = true){
            ~cutting_animation;
            if (inv_total(inv, feather) < 15) {
                mes("You need at least 15 feathers to do this.");
                return;
            }
            inv_del(inv, kalphite_stinger, 1);
            inv_del(inv, feather, 15);
            inv_add(inv, blow_dart, 15);
            stat_advance(fletching, 750);
            mes("You shave down the stinger and attach the feather make some darts.");
        }
    }
    case default : ~displaymessage(^dm_default);
}