        ~mesbox("You are not currently on a Runecrafting task.");
        return;
    }
}

[opheld1,rune_fragment]
def_int $tot = inv_total(inv,rune_fragment);
def_int $tot2 = inv_total(inv,rune_dust);
def_int $base = stat_base(runecraft);
def_int $new = calc($base + 25);
def_int $diff = calc($new - $base);
if ($tot >= 100 & $tot2 >= 100) {
    inv_del(inv, rune_fragment, 100);
    inv_del(inv, rune_dust, 100);
    inv_add(inv, blankrune, 1);
    ~stat_action(runecraft, $diff);
} else {
    mes("You need at least 100 Fragments and 100 Rune Dust to combine them together.");
}

