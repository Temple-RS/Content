[debugproc,all_talismans]
inv_add(inv, air_talisman,1);
inv_add(inv, earth_talisman,1);
inv_add(inv, fire_talisman,1);
inv_add(inv, water_talisman,1);
inv_add(inv, chaos_talisman,1);
inv_add(inv, mind_talisman,1);
inv_add(inv, body_talisman,1);
inv_add(inv, nature_talisman,1);
inv_add(inv, cosmic_talisman,1);
mes("You have been given all the talismans!");