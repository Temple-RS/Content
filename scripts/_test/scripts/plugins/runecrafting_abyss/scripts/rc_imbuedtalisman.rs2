[proc,airaltar]
if (%rc_rep < 0) {
    ~chatnpc("You are not yet recognized by the Magicians' Guild. Earn reputation through Runecrafting Tasks first!");
    return;
}
if (inv_total(inv, imbued_dust) > 2499) {
    p_telejump(0_44_75_25_30);
    inv_del(inv, imbued_dust, 2500);
    %teleportlocation = ^mageguild;
} else {
    ~chatnpc("You need at least 2500 Imbued Dust to use the Air Altar!");
}

[proc,mindaltar]
if (%rc_rep < 0) {
    ~chatnpc("You must gain some reputation before the guild allows access to this altar.");
    return;
}
if (inv_total(inv, imbued_dust) > 2499) {
    p_telejump(0_43_75_41_29);
    inv_del(inv, imbued_dust, 2500);
    %teleportlocation = ^mageguild;
} else {
    ~chatnpc("You need at least 2500 Imbued Dust to use the Mind Altar!");
}

[proc,wateraltar]
if (%rc_rep < 250) {
    ~chatnpc("You need at least 250 Runecraft Reputation to use the Water Altar.");
    return;
}
if (inv_total(inv, imbued_dust) > 2499) {
    p_telejump(0_42_75_37_32);
    inv_del(inv, imbued_dust, 2500);
    %teleportlocation = ^mageguild;
} else {
    ~chatnpc("You need at least 2500 Imbued Dust to use the Water Altar!");
}

