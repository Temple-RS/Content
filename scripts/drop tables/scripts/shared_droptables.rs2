[proc,expitemtable]()(namedobj,int)
def_int $random = 0;
$random = random(10);

if ($random < 1) {
    return (cavalier_brown,1);
} else if ($random < 5) {
    return (highwaymanmask,1);
} else if ($random < 8) {
    return (headband_red,1);
}

[proc,grindingtable]()(namedobj,int)
def_int $random = max(1, random(15));
def_int $variation = max(10, randominc(40));
if ($random < 1) {
    return (iron_arrow,30);
} else if ($random < 2) {
    return (steel_arrow, 4);
} else if ($random < 4) {
    return (mindrune, $variation);
} else if ($random < 5) {
    return (airrune, $variation);
} else if ($random < 6) {
    return (blankscroll, calc(max(1, random(3))));    
} else if ($random < 8) {
    return (coins, 57);
} else if ($random < 9) {
    return (anchovies, 4);
} else if ($random < 10) {
    return (lumbyscroll, 1);
} else if ($random < 11) { // Corrected syntax and ensured draynorscroll is reachable
    return (draynorscroll, 1);
} else if ($random < 12) { // Ensured salmon is reachable
    return (salmon, 2);
} else if ($random < 13) {
    return (~skill_table(ranged));
} else if ($random < 14) {
    return (~skill_table(magic));
} else if ($random < 15){
    return (feather, calc(max(10, $variation)));
}
return (coins, 1);


[proc,legendarytable]()(namedobj,int)
def_int $random = 0;
$random = random(128);

if ($random < 25) {
    return (~randomjewel);
} else if ($random < 51) {
    return (~grindingtable);
} else if ($random < 51) {
    return (rune_knife_p,50);
} else if ($random < 56) {
    return (crystal_key,1);
} else if ($random < 58) {
    return (magic_shortbow,1);
    return (steel_arrow,150);
} else if ($random < 59) {
    return (rune_dart,50);
} else if ($random < 60) {
    return (rune_thrownaxe,35);
} else if ($random < 61) {
    return (opal_bolt, 27);
} else if ($random < 62) {
    switch_int(random(4)){
        case 1 : return(rcu_pouch_large, 1);
        case 2 : return(rcu_pouch_giant, 1);
        case default : return(coins, 235);
    }
} else if ($random < 128) {
    return (~elite_tier_items);
}
return (coins, 1);


[proc,talisman_table]()(namedobj,int)

def_int $random = random(128);

if ($random < 1) {
    return (earth_talisman, 1);
} else if ($random < 4) {
    return (air_talisman, 1);
} else if ($random < 5) {
    return (fire_talisman, 1);
} else if ($random < 10) {
    return (water_talisman, 1);
} else if ($random < 14) {
    return (mind_talisman, 1);
} else if ($random < 16) {
    return (body_talisman, 1);
} else if ($random < 23) {
    return (blood_talisman, 1);
} else if ($random < 24) {
    return (nature_talisman, 1);
} else if ($random < 49) {
    return (law_talisman, 1);
} else if ($random < 74) {
    return (soul_talisman, 1);
} else if ($random < 84) {
    return (chaos_talisman, 1);
} else if ($random < 94) {
    return (death_talisman, 1);    
} else if ($random < 99) {
    return (death_talisman, 1);
} else if ($random < 128) {
    return (cosmic_talisman, 1);
}
return (coins, 1);

