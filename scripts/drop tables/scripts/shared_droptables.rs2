// Name leaked
[proc,randomherb]()(namedobj, int)

if(map_members = ^false) {
    return (coins, 10);
}

def_int $random = 0;

$random = random(128);

if ($random < 32) {
    return (unidentified_guam, 1);
} else if ($random < 56) {
    return (unidentified_marentill, 1);
} else if ($random < 74) {
    return (unidentified_tarromin, 1);
} else if ($random < 88) {
    return (unidentified_harralander, 1);
} else if ($random < 99) {
    return (unidentified_ranarr, 1);
} else if ($random < 107) {
    return (unidentified_irit, 1);
} else if ($random < 113) {
    return (unidentified_avantoe, 1);
} else if ($random < 118) {
    return (unidentified_kwuarm, 1);
} else if ($random < 122) {
    return (unidentified_cadantine, 1);
} else if ($random < 125) {
    return (unidentified_lantadyme, 1);
} else if ($random < 128) {
    return (unidentified_dwarf_weed, 1);
}

// Name leaked
[proc,randomjewel]()(namedobj, int)
def_int $random = 0;

if (inv_total(worn, ring_of_wealth) > 0) {
    $random = random(65);
} else {
    $random = random(128);
}

if ($random < 32) {
    return (uncut_sapphire, 1);
} else if ($random < 48) {
    return (uncut_emerald, 1);
} else if ($random < 56) {
    return (uncut_ruby, 1); 
} else if ($random < 58) {
    return (uncut_diamond, 1);
} else if ($random < 59) {
    if (map_members = ^true) {
        return (rune_javelin, 5);
    }
} else if ($random < 60) {
    if (map_members = ^true) {
        return (keyhalf1, 1);
    }
} else if ($random < 61) {
    if (map_members = ^true) {
        return (keyhalf2, 1);
    }
} else if ($random < 125) {
    if (map_members = ^true) {
        return(coins,100);
    }
} else if($random < 65) {
    if (map_members = ^true) {
        if (coordz(coord) > 6400) {
            return (chaos_talisman, 1);
        } else {
            return (nature_talisman, 1);
        }
    }
}

