[proc,scrollpack]()(namedobj, int)

def_int $scroll = random(6);

switch_int($scroll) {
    case 1 : return(lumbyscroll, 1);
    case 2 : return(draynorscroll, 1);
    case 3 : return(yanillescroll, 1);
    case 4 : return(shiloscroll, 1);
    case 5 : return(blankscroll, 1);
    case 6 : ~scrollpack;
}


