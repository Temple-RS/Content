[proc,wilderness_table]()(namedobj,int)
def_int $random = random(128);
def_int $r2 = random(128);
if ($r2 > 2){
    return(coins, 250);
} else {
    if ($random < 8) {
        return (mithril_sword, 1);
    } else if ($random < 9){
        return (lobster, 5);
    } else if ($random < 12) {
        return (mithril_chainbody, 1);
    } else if ($random < 13) {
        return (mithril_platebody, 1);
    } else if ($random < 14) {
        return (mithril_platelegs, 1);
    } else if ($random < 15) {
        return (mithril_plateskirt, 1);
    } else if ($random < 16) {
        return (mithril_full_helm, 1);    
    } else if ($random < 17) {
        switch_int(random(4)){
            case 1 : return(rcu_pouch_medium, 1);
            case 2 : return(rcu_pouch_large, 1);
            case 3 : return(rcu_pouch_giant, 1);
            case default : return(coins, 54);
        }
    } else if ($random < 18) {
        return (mithril_med_helm, 1);
    } else if ($random < 19) {
        return (mithril_mace, 1);
    } else if ($random < 20) {
        return (edgevillescroll,3);
    } else if ($random < 25) {
        return (shiloscroll,5);
    } else if ($random < 28) {
        return (edgevillescroll,1);
    } else if ($random < 34) {
        return (~talisman_table);
    } else if ($random < 50) {
        return (mithril_battleaxe, 1);
    } else if ($random < 58) {
        return (~randomherb);
    } else if ($random < 63) {
        return (uncut_emerald, 1);
    } else if ($random < 67) {
        return (uncut_ruby, 1);
    } else if ($random < 71) {
        return (naturerune, ~random_range(2, 5));
    } else if ($random < 75) {
        return (lawrune, ~random_range(3, 6));
    } else if ($random < 79) {
        return (deathrune, ~random_range(3, 5));
    } else if ($random < 83) {
        return (chaosrune, ~random_range(8, 15));
    } else if ($random < 87) {
        return (mithril_arrow, ~random_range(15, 30));
    } else if ($random < 91) {
        return (steel_arrow, ~random_range(25, 40));
    } else if ($random < 95) {
        return (mithril_ore, ~random_range(2, 4));
    } else if ($random < 99) {
        return (gold_ore, ~random_range(1, 3));
    } else if ($random < 103) {
        return (gold_bar, ~random_range(1, 2));
    } else if ($random < 107) {
        return (swordfish, ~random_range(2, 4));
    } else if ($random < 111) {
        return (feather, ~random_range(50, 100));
    } else if ($random < 117) {
        return (uncut_diamond, 1);
    } else if ($random < 118) {
        return (~mid_tier_items);
    } else if ($random < 119) {
        return (~high_tier_items);
    } else if ($random < 124) {
        return (unidentified_ranarr, 1);
    } else if ($random < 125) {
        return (adamant_chainbody,1);
    } else if ($random < 126) {
        return (adamant_sword,1);
    }  else if ($random < 127) {
        return (adamant_mace,1);
    }  else if ($random < 128) {
        return (adamant_arrowheads,50);
    }
}
return (coins, 250);

