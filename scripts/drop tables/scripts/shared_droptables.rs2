// Name leaked
[proc,randomjewel]()(namedobj, int)
def_int $random = 0;

if (inv_total(worn, ring_of_wealth) > 0) {
    $random = random(65);
} else {
    $random = random(128);
}

if ($random < 32) {
    return (uncut_sapphire, 1);
} else if ($random < 48) {
    return (uncut_emerald, 1);
} else if ($random < 56) {
    return (uncut_ruby, 1); 
} else if ($random < 58) {
    return (uncut_diamond, 1);
} else if ($random < 59) {
    if (map_members = ^true) {
        return (rune_javelin, 5);
    }
} else if ($random < 60) {
    if (map_members = ^true) {
        return (keyhalf1, 1);
    }
} else if ($random < 61) {
    if (map_members = ^true) {
        return (keyhalf2, 1);
    }
} else if ($random < 125) {
    if (map_members = ^true) {
        return(coins,100);
    }
} else if($random < 65) {
    if (map_members = ^true) {
        if (coordz(coord) > 6400) {
            return (chaos_talisman, 1);
        } else {
            return (nature_talisman, 1);
        }
    }
}

