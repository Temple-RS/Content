[opheld4,_category_136]
// https://youtu.be/vGH1Nyp4IBU
mes("You rub the ring...");
def_obj $item = last_item;
def_int $slot = last_slot;
// Snapshot whether the ring is worn BEFORE any delays.
// We use inv_total to avoid an out-of-bounds crash: inv_getobj(worn, $slot)
// would be unsafe here because $slot is an inventory index (0-27) while the
// worn container only has ~12 slots, causing a server exception on high slots.
def_boolean $was_worn;
if (inv_total(worn, $item) > 0){
    $was_worn = true;
} else {
    $was_worn = false;
}
p_delay(1);
def_int $choice = ~p_choice2_header("Al Kharid Duel Arena.", 1, "Nowhere.", 2, "Where would you like to teleport to?");
if($choice = 2) {
    mes("You remain where you were.");
    return;
}
if (~wilderness_level(coord) > 0) {
    // yes it actually says this in osrs
    mes("A mysterious force blocks your teleport spell!");
    mes("You can't use this teleport in the wilderness.");
    return;
}
if (~pre_tele_checks(coord) = false) {
    return;
}
~player_teleport_normal(map_findsquare(0_51_50_51_35, 0, 2, ^map_findsquare_lineofwalk));
def_namedobj $new_ring = oc_param($item, next_obj_stage);
// osrs uses lowercase in the name.
// 2006: https://www.youtube.com/watch?v=dTLr_7HhgXw
if ($was_worn = true) {
    if ($new_ring = null) {
        inv_delslot(worn, $slot);
        mes("Your Ring of Dueling crumbles to dust.");
    } else {
        inv_setslot(worn, $slot, $new_ring, 1);
        mes("Your Ring of Dueling has <~pluralise(oc_param($new_ring, charges), "use")> left.");
    }
} else {
    if ($new_ring = null) {
        inv_delslot(inv, $slot);
        mes("Your Ring of Dueling crumbles to dust.");
    } else {
        inv_setslot(inv, $slot, $new_ring, 1);
        mes("Your Ring of Dueling has <~pluralise(oc_param($new_ring, charges), "use")> left.");
    }
}
